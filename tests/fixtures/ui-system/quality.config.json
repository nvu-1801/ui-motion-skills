{
  "version": 1,
  "profile": "ui-system",
  "checks": [
    {
      "id": "typecheck",
      "command": [
        "npm",
        "run",
        "typecheck"
      ],
      "required": true,
      "timeoutSeconds": 120
    },
    {
      "id": "contracts",
      "command": [
        "npm",
        "test"
      ],
